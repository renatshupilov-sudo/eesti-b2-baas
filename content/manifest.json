 "changelog": [
  {
   "version": "2026.11.26-5",
   "date": "2026-11-26",
   "ru": "Вместо диктантов из отдельных предложений — короткие диалоги с вопросами. Урок 7: длинная лекция «Eesti mets» (около 5–6 минут). Выбор мужского или женского голоса, речь по умолчанию медленнее на 20%."
  },
  {
   "version": "2026.11.26-4",
   "date": "2026-11-26",
   "ru": "Слова заменены на лексику уровня B2. Связки и фразы проверяются автоматически. В уроке 1 вместо порядка слов — словообразование. Итог урока с советом. Ссылки на живое аудирование ERR Jupiter. План тем."
  },
  {
   "version": "2026.11.26-3",
   "date": "2026-11-26",
   "ru": "Настоящая эстонская озвучка (TartuNLP Neurokõne) для аудирования, диктантов и слов вместо голоса телефона."
  },
  {
   "version": "2026.11.26-2",
   "date": "2026-11-26",
   "ru": "Убрана устная часть. Уроки 4 и 9 заменены на аудирование и чтение. К словам добавлены ссылки на словарь EKI (Sõnaveeb)."
  },
  {
   "version": "2026.11.26-1",
   "date": "2026-11-26",
   "ru": "Первая версия: 14 уроков (2 недели), все 4 части экзамена + грамматика и мини-пробный экзамен."
  }
 ],
